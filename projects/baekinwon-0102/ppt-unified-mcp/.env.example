# Optional when the three repositories are not siblings.
PPT_TO_PYTHON_ROOT=C:\path\to\ppt-to-python
PPT_TO_COM_ROOT=C:\path\to\ppt-to-com

# All newly generated projects are confined below this directory.
PPT_UNIFIED_WORKSPACE=C:\path\to\ppt-projects

# Optional behavior inherited from ppt-mcp.
PPT_AUTO_DISMISS_DIALOG=false

# Edit mode defaults to 13 public tools while retaining all COM capabilities.
# Set to full only for clients that can handle all 155 tool schemas.
PPT_EDIT_PROFILE=compact
