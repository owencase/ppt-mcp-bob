# ─── Node ──────────────────────────────────────────────────────────────────
node_modules/
build/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.npm/

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
